# Normalize line endings for cross‑platform consistency
* text=auto eol=lf

# Treat common binary assets correctly
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp3  binary
*.wav  binary
*.ogg  binary
*.mp4  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary

# Keep SVGs as text for diffs
*.svg text

# Reduce noisy diffs
package-lock.json -diff
